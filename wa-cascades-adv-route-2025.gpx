<?xml version="1.0" ?><gpx xmlns="http://www.topografix.com/GPX/1/1" creator="GaiaGPS" version="1.1" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://www.topografix.com/GPX/1/1 http://www.topografix.com/GPX/1/1/gpx.xsd"><wpt lat="46.2945386" lon="-121.5494224"><time>2022-07-13T23:46:12Z</time><name>Kellen Creek Campground</name><sym>campsite-24</sym></wpt><wpt lat="46.4654939" lon="-121.5318309"><time>2022-07-13T23:46:12Z</time><name>Chambers Lake Campground</name><sym>campsite-24</sym></wpt><wpt lat="46.0990297" lon="-121.7201452"><time>2022-07-13T23:46:12Z</time><name>Langfield Falls trailhead</name><sym>known-route</sym></wpt><wpt lat="45.9206814" lon="-121.694748"><time>2022-07-13T23:46:12Z</time><name>Campsite</name><sym>campsite-24</sym></wpt><wpt lat="46.0844247" lon="-121.7592297"><time>2022-07-13T23:46:12Z</time><name>Dispersed Camping</name><sym>campsite-24</sym></wpt><wpt lat="46.263146" lon="-121.6325718"><time>2022-07-13T23:46:12Z</time><name>Council Bluff trailhead</name><sym>known-route</sym></wpt><wpt lat="45.9398899" lon="-121.7578531"><time>2022-07-13T23:46:12Z</time><name>Goose Lake Campground</name><sym>campsite-24</sym></wpt><wpt lat="46.2931032" lon="-121.5963254"><time>2022-07-13T23:46:12Z</time><name>Chain of Lakes Campground</name><sym>campsite-24</sym></wpt><wpt lat="46.2632724" lon="-121.6317773"><time>2022-07-13T23:46:12Z</time><name>Council Lake Campground</name><sym>campsite-24</sym></wpt><wpt lat="46.0323845" lon="-121.6900511"><time>2022-07-13T23:46:12Z</time><name>Smoky Creek Campground</name><sym>campsite-24</sym></wpt><wpt lat="46.1347585" lon="-121.727421"><time>2022-07-13T23:46:12Z</time><name>Steamboat Viewpoint trail</name><sym>known-route</sym></wpt><wpt lat="46.5356434" lon="-121.9569947"><time>2022-07-13T23:46:12Z</time><name>Gas Station</name><sym>fuel-24</sym></wpt><wpt lat="46.3097794" lon="-121.5666315"><time>2022-07-13T23:46:12Z</time><name>Horseshoe Lake Campground</name><sym>campsite-24</sym></wpt><wpt lat="45.9620429" lon="-121.7580642"><time>2022-07-13T23:46:12Z</time><name>Forlorn Lakes Campground</name><sym>campsite-24</sym></wpt><wpt lat="46.4264164" lon="-121.4898867"><time>2022-07-13T23:46:12Z</time><name>Walupt Creek Falls Trailhead</name><sym>known-route</sym></wpt><wpt lat="46.086326" lon="-121.7591841"><time>2022-07-13T23:46:12Z</time><name>Cold Spring Lake Dispersed Camping</name><sym>campsite-24</sym></wpt><wpt lat="46.348555" lon="-121.6249554"><time>2022-07-13T23:46:12Z</time><name>Cat Creek Campground</name><sym>campsite-24</sym></wpt><wpt lat="46.060343" lon="-121.970704"><time>2022-07-13T23:46:12Z</time><name>Curly Creek Falls Trailhead</name><sym>known-route</sym></wpt><wpt lat="45.8015433" lon="-121.6436367"><time>2022-07-13T23:46:12Z</time><name>Big Cedars County Park</name><sym>campsite-24</sym></wpt><wpt lat="46.1118747" lon="-121.7688007"><time>2022-07-13T23:46:12Z</time><name>South Campground</name><sym>campsite-24</sym></wpt><wpt lat="46.0938489" lon="-121.7777366"><time>2022-07-13T23:46:12Z</time><name>Campsite</name><sym>campsite-24</sym></wpt><wpt lat="46.3246227" lon="-121.9247544"><time>2022-07-13T23:46:12Z</time><name>Pinto Rock Trailhead</name><sym>known-route</sym></wpt><wpt lat="46.3953691" lon="-121.6158923"><time>2022-07-13T23:46:12Z</time><name>Camp</name><sym>campsite-24</sym></wpt><wpt lat="46.1324553" lon="-121.7157975"><time>2022-07-13T23:46:12Z</time><name>Steamboat Lake Campground</name><sym>campsite-24</sym></wpt><wpt lat="46.0891629" lon="-121.7563818"><time>2022-07-13T23:46:12Z</time><name>Campsite</name><sym>campsite-24</sym></wpt><wpt lat="45.7410648" lon="-121.8213691"><time>2022-07-13T23:46:12Z</time><name>Gas Station</name><sym>fuel-24</sym></wpt><wpt lat="45.8197869" lon="-121.8798792"><time>2022-07-13T23:46:12Z</time><name>Panther Creek Campground</name><sym>campsite-24</sym></wpt><wpt lat="46.2163779" lon="-121.6698939"><time>2022-07-13T23:46:12Z</time><name>Twin Falls Campground</name><sym>campsite-24</sym></wpt><wpt lat="46.3389352" lon="-121.646914"><time>2022-07-13T23:46:12Z</time><name>Adams Fork Campground</name><sym>campsite-24</sym></wpt><wpt lat="46.3060323" lon="-121.9255096"><time>2022-07-13T23:46:12Z</time><name>Campsite</name><sym>campsite-24</sym></wpt><wpt lat="46.0908091" lon="-121.756347"><time>2022-07-13T23:46:12Z</time><name>Campsite</name><sym>campsite-24</sym></wpt><wpt lat="46.2886796" lon="-121.6194929"><time>2022-07-13T23:46:12Z</time><name>Olalli Lake Campground</name><sym>campsite-24</sym></wpt><wpt lat="46.048001" lon="-121.7548077"><time>2022-07-13T23:46:12Z</time><name>Cultus Creek Campground</name><sym>campsite-24</sym></wpt><wpt lat="46.0375929" lon="-121.71452"><time>2022-07-13T23:46:12Z</time><name>Little Goose Campground</name><sym>campsite-24</sym></wpt><wpt lat="46.3123332" lon="-121.5547254"><time>2022-07-13T23:46:12Z</time><name>Spring Creek Campground</name><sym>campsite-24</sym></wpt><wpt lat="46.4457287" lon="-121.8669807"><time>2022-07-13T23:46:12Z</time><name>Tower Rock Campground</name><sym>campsite-24</sym></wpt><wpt lat="46.0912889" lon="-121.76107"><time>2022-07-13T23:46:12Z</time><name>Campsite</name><sym>campsite-24</sym></wpt><wpt lat="46.423126" lon="-121.474091"><time>2022-07-13T23:46:12Z</time><name>Walupt Lake Campground</name><sym>campsite-24</sym></wpt><wpt lat="46.0575512" lon="-121.975125"><time>2022-07-13T23:46:12Z</time><name>Miller Creek Falls</name><sym>waterfall</sym></wpt><wpt lat="46.4510935" lon="-121.7875965"><time>2022-07-13T23:46:12Z</time><name>North Fork Campground</name><sym>campsite-24</sym></wpt><wpt lat="46.3961164" lon="-121.6146263"><time>2022-07-13T23:46:12Z</time><name>Camp</name><sym>campsite-24</sym></wpt><wpt lat="46.0807889" lon="-121.9637517"><time>2022-07-13T23:46:12Z</time><name>House Rock Shelter</name><sym>campsite-24</sym></wpt><wpt lat="46.1235268" lon="-121.7790689"><time>2022-07-13T23:46:12Z</time><name>Tillicum Campground</name><sym>campsite-24</sym></wpt><wpt lat="46.0812257" lon="-121.7525497"><time>2022-07-13T23:46:12Z</time><name>Cold Spring Campground</name><sym>campsite-24</sym></wpt><wpt lat="46.6667202" lon="-121.8914148"><time>2022-07-13T23:46:12Z</time><name>High Rock Trailhead</name><desc>3 mile out-and-back trail to the lookout.  &lt;br&gt;&lt;br&gt;https://www.alltrails.com/trail/us/washington/high-rock-lookout-trail</desc><sym>known-route</sym></wpt><wpt lat="46.2807141" lon="-121.5986636"><time>2022-07-13T23:46:12Z</time><name>Takhlakh Lake Campground</name><sym>campsite-24</sym></wpt><wpt lat="45.9439056" lon="-121.8692518"><time>2022-07-13T23:46:12Z</time><name>Falls Creek Caves Trailhead</name><sym>known-route</sym></wpt><wpt lat="45.8654177" lon="-121.7088535"><time>2022-07-13T23:46:12Z</time><name>Campsite</name><sym>campsite-24</sym></wpt><wpt lat="45.9088932" lon="-121.8010315"><time>2022-07-13T23:46:12Z</time><name>Crest Camp</name><sym>campsite-24</sym></wpt><wpt lat="46.0218226" lon="-121.7188625"><time>2022-07-13T23:46:12Z</time><name>Campsite</name><sym>campsite-24</sym></wpt><wpt lat="46.4297994" lon="-121.9869192"><time>2022-07-13T23:46:12Z</time><name>Iron Creek Campground</name><sym>campsite-24</sym></wpt><wpt lat="46.3513268" lon="-121.5235939"><time>2022-07-13T23:46:12Z</time><name>Midway Warming Hut</name><desc>The warming hut itself is a simple, non-reservable shelter, typically equipped with a wood-burning stove to provide respite and emergency shelter for winter enthusiasts. It serves as a base camp for accessing the area's extensive network of winter trails, which includes over 16 kilometers of marked (but ungroomed) ski and snowshoe trails, and over 150 miles of groomed snowmobile trails.

Although the Midway High Lakes Area is best known in summer for its scenic lakes (such as Takhlakh, Council, and Olallie), the hut is essential for utilizing the high-elevation trails when the main forest roads (like NF-23) are closed due to deep snow, typically from November through May. The Sno-Park and its associated hut provide critical access to a rugged winter environment that offers views of the surrounding Cascade peaks, including Mount Adams.</desc><sym>building-24</sym></wpt><wpt lat="46.338113" lon="-121.6478366"><time>2022-07-13T23:46:12Z</time><name>DP - Cispus River</name><desc>The Cispus River is a major waterway in the southern Washington Cascades, flowing approximately 54 miles (87 km) and draining a large basin in Lewis and Skamania Counties. Its headwaters begin in a high, glacial valley near Snowgrass Flats in the Goat Rocks Wilderness within the northern boundary of the Gifford Pinchot National Forest. The river then loops southwesterly before its course is significantly altered by tributaries, notably receiving Muddy Fork, which carries glacial silt and debris from Mount Adams’s Lava Glacier. The river ultimately flows into the Cowlitz River at Lake Scanewa, near the Cowlitz Falls Dam.

Historically, the river valley has been a vital area for Indigenous peoples, with archaeological evidence pointing to use for thousands of years. The Upper Cowlitz tribe referred to residents on the river as the cispaclama. The valley also features numerous &quot;basket trees&quot;—Western Red Cedars with scars indicating that their bark was traditionally removed by Native Americans for making baskets and other essential items. The river gives its name to the Cispus Learning Center, a former Civilian Conservation Corps (CCC) camp and Job Corps site that now serves as a key outdoor education facility, preserving some of the history of the region.

The Cispus River basin is highly valued for both its ecology and recreation. Much of its upper course flows through the protected National Forest, where it is paralleled by Forest Road 21 and Forest Road 23, providing access to campgrounds like Adams Fork and North Fork. The surrounding area is known for its old-growth Douglas fir forests, and the river itself is popular for fishing, particularly for brook trout. However, the water below the confluence with Muddy Fork is often cloudy with glacial silt, making fishing more challenging there.</desc><sym>water</sym></wpt><wpt lat="46.3903281" lon="-121.6065591"><time>2022-07-13T23:46:12Z</time><name>DP - Hamilton Buttes</name><desc>Hamilton Buttes is a group of elevated summits located in the Cowlitz Valley Ranger District of the Gifford Pinchot National Forest, Washington. The primary butte reaches an elevation of approximately 5,772 feet (1,759 meters) and is a prominent landmark in the rugged Dark Divide Roadless Area. The Buttes are a central feature of a high-country trail network that includes the Hamilton Ridge Trail and the Blue Lake Butte Trail, and are prized for their sweeping, long-distance views.

The site is historically recognized as an important post for forest protection. A fire lookout structure was built on nearby Hamilton Peak in 1929 to monitor the vast expanse of the forest. The lookout was actively staffed for decades, but like many remote fire watch stations, it was ultimately abandoned in the 1960s in favor of more modern fire detection methods. Remnants of this history, such as sections of the old telephone line that connected the lookout to the world below, can still be found along the connecting trails.

Today, the Hamilton Buttes area is a popular, multi-use recreation destination. The Hamilton Buttes Trail (#118) is open to hikers, horses, bicycles, and motorcycles. The ascent to the open, upper meadows offers clear, unparalleled vistas. From the summit area, visitors can achieve panoramic sightlines of the major Cascade volcanoes, including Mount Rainier to the north, Mount Adams to the east, Mount St. Helens to the southwest, and the jagged crests of the Goat Rocks Wilderness to the northeast.

The high-elevation meadows and ridges surrounding the Buttes are known for their late summer display of wildflowers and their abundance of huckleberries, making the area a seasonal favorite for recreational harvesting. Due to its challenging access via a network of rough, high-clearance Forest Service roads, the area maintains a feeling of remoteness.</desc><sym>peak</sym></wpt><wpt lat="46.4372196" lon="-121.6869999"><time>2022-07-13T23:46:12Z</time><name>DP - Bishop Falls</name><desc>Bishop Falls is a hidden, multi-tiered waterfall located on a small, unnamed creek that drains a portion of Bishop Ridge in the Lewis County section of the Gifford Pinchot National Forest. Situated in the North Fork Cispus River drainage, the falls are not well-known due to their remote location within a deep, steep-sided canyon, making them challenging to access.

The falls are believed to be divided into at least two substantial drops, occurring in immediate succession below Forest Road 78. The upper tier of Bishop Falls is estimated to plunge approximately 60 feet, starting with a slide down a pitched formation before making an S-bend and dropping to the canyon floor. A short distance downstream lies a second tier, often referred to as Lower Bishop Falls, which is also estimated to be over 60 to 75 feet high. The overall drop of the feature is significant, making the small creek one of the most tumultuous in the North Fork Cispus drainage.

The unofficial name for the waterfall, Bishop Falls, was suggested because the creek originates from the higher ground of Bishop Ridge. The ridge itself is traversed by Bishop Ridge Trail (#272), a rigorous and exposed path known for its technical difficulty, which is popular with hikers, horses, and motorcycles. The area is part of the extensive trail network within the rugged Dark Divide Roadless Area, offering excellent views down into the North Fork of the Cispus River valley.</desc><sym>waterfall</sym></wpt><wpt lat="46.48861302797761" lon="-121.40836715698242"><time>2025-10-08T14:11:29Z</time><name>DP - Gilbert Peak</name><desc>Gilbert Peak (also known as Mount Curtis Gilbert) is the highest summit in the rugged Goat Rocks Wilderness, situated in the Cascade Range of Washington State. It has an elevation of 8,184 feet (2,494 meters), although some sources place the benchmark at 8,201 feet. The peak straddles the border of the Gifford Pinchot National Forest (Cowlitz Valley Ranger District) to the west and the Yakama Indian Reservation and Okanogan-Wenatchee National Forest to the east.

Geologically, the Goat Rocks are the heavily eroded remnants of a massive, extinct Pliocene stratovolcano that was active approximately two million years ago. Intense glaciation and erosion have since carved the volcano’s interior, creating the distinct, exposed alpine landscape characterized by jagged ridges and open meadows. Gilbert Peak itself retains permanent ice and snow features, including the Conrad Glacier on its north slope and the Meade Glacier on its southeastern slopes.

The peak is a challenging and strenuous objective for experienced hikers and scramblers. The climb often involves snow travel, requiring the use of specialized gear such as ice axes and crampons, and the final ascent to the summit block involves a Class 3 scramble over loose rock. The primary non-technical routes, such as the Klickton Divide route, typically begin from the Conrad Meadows Trailhead and follow trails through the high alpine parklands of the wilderness area.

The summit provides truly expansive views that span across most of Washington's southern Cascades. From the top, climbers are rewarded with spectacular sightlines to the surrounding volcanoes: Mount Rainier to the north, Mount Adams to the south-southeast, and Mount St. Helens to the southwest. The name honors Curtis Gilbert, a longtime Boy Scout leader from Yakima who was instrumental in fostering youth access to the region.</desc><sym>peak</sym></wpt><wpt lat="46.4811976" lon="-121.5152929"><time>2022-07-13T23:46:12Z</time><name>Goat Ridge Lookout</name><sym>binoculars</sym></wpt><wpt lat="46.4314153" lon="-121.4983625"><time>2022-07-13T23:46:12Z</time><name>DP - Walupt Creek Falls</name><desc>Walupt Creek Falls is a spectacular, multi-tiered waterfall located in a remote part of the Gifford Pinchot National Forest in Lewis County, Washington. It flows along Walupt Creek, a significant tributary that feeds the Cispus River. The falls are unofficially estimated to be approximately 220 to 245 feet (67 to 75 meters) high and are noted for their unique characteristic: the water tumbles down the steep, rugged basalt rock face, often flowing in multiple directions before collecting on a plateau and continuing its descent.

The falls sit at an elevation of approximately 3,500 feet on the northwest flank of the Goat Rocks Wilderness, an area famous for its alpine meadows and jagged, eroded volcanic peaks. Unlike many waterfalls in the region, Walupt Creek Falls is considered an &quot;off-grid dynamo&quot; and lacks an official, maintained U.S. Forest Service trail. The route is often a steep, unmaintained use-trail that requires scrambling over fallen trees and a careful crossing of Walupt Creek, making it a challenging destination for only experienced hikers.

The remoteness and lack of crowds contribute to the falls’ allure, allowing the visitor to experience the full, awesome power of the water in a quiet, untamed wilderness setting. The creek that feeds the falls is sourced from the higher-elevation Walupt Lake, the second-largest lake in the Gifford Pinchot National Forest, which acts as a reservoir, ensuring a healthy flow throughout the summer and fall. The trailhead is generally accessed via Forest Road 21 near the Walupt Horse Camp, a short distance from the Goat Rocks Wilderness boundary.</desc><sym>waterfall</sym></wpt><wpt lat="46.4167818" lon="-121.4638236"><time>2022-07-13T23:46:12Z</time><name>DP - Walupt Lake</name><desc>Walupt Lake is a large, freshwater ribbon lake located at an elevation of 3,927 feet (1,197 meters) in Lewis County, Washington, near the town of Packwood. It is the second-largest lake in the Gifford Pinchot National Forest, covering an area of approximately 350 acres (140 hectares), and is the deepest lake in the county, plunging to a maximum depth of 300 feet. The lake lies at the end of a long, glaciated valley and was formed by an ancient landslide that slid down from the northwest end of the ridge, creating a natural dam that allowed the basin to fill with water.

The lake is a central feature of the rugged landscape surrounding the Goat Rocks Wilderness; its eastern half is technically within the Wilderness boundary. Its name, Walupt, is of Yakama origin, given by surveyor Albert Hale Sylvester, who learned from Native Americans that it was the traditional Yakama name for the region. Walupt Creek is both the main inflow (fed by perennial snowmelt) and the outflow, exiting the lake on its northwestern corner and flowing toward the Cispus River.

Walupt Lake is a highly popular, high-elevation destination for recreation, typically accessible by vehicle only from late May to late October due to snow. The Walupt Lake Campground is a major staging area for the Goat Rocks Wilderness, with the Nannie Ridge Trail ($#98)andWaluptLakeTrail(#$101) providing access to the Pacific Crest National Scenic Trail (PCT). The lake itself is known for excellent fishing for Rainbow and Cutthroat Trout, and non-motorized activities such as boating, kayaking, and swimming are common on its clear mountain waters.</desc><sym>lake</sym></wpt><wpt lat="46.6844957" lon="-121.9013926"><time>2022-07-13T23:46:12Z</time><name>DP - High Rock Lookout</name><desc>High Rock Lookout is an iconic and historic fire lookout station located atop High Rock, the most prominent point along the Sawtooth Ridge in the Gifford Pinchot National Forest, Washington. Situated near the northern boundary of the forest, the lookout provides one of the most stunning panoramic views in the South Cascades, with a direct, in-your-face sightline of Mount Rainier only 13 air miles away, as well as clear views of the Tatoosh Range, Mount Adams, and Mount St. Helens.

The lookout structure, a 14x14-foot gable roof L-4 ground house, was originally constructed in 1929-1931 with materials hauled in by pack mule from Mineral, Washington. Its location at an elevation of 5,685 feet (1,732 meters), perched on the edge of a sheer cliff with a vertical 600-foot drop on its north face, made it a crucial and strategic fire detection post for the Forest Service until it was last staffed in 2004. The lookout is now listed on the National Historic Lookout Register.

The site is accessed via the popular and moderately steep High Rock Trail ($#$266), a 1.6-mile path that climbs approximately 1,350 feet from the Towhead Gap trailhead. Due to years of neglect, extreme weather, and vandalism, the lookout structure underwent a community-driven, multi-phased restoration effort that began in the 2020s. This effort required the temporary removal of the structure for off-site restoration and foundation work.</desc><sym>fire-lookout</sym></wpt><wpt lat="46.8522657" lon="-121.7605771"><time>2022-07-13T23:46:12Z</time><name>DP - Mt Rainier</name><desc>Mount Rainier (known as Tahoma or Takhoma by the Puyallup and other Indigenous tribes, meaning &quot;the great snowy mountain&quot;) is the highest mountain in the U.S. state of Washington and the tallest peak in the entire Cascade Volcanic Arc, rising to an officially recognized summit elevation of 14,410 feet (4,392 meters) at the Columbia Crest. Located approximately 60 miles southeast of Seattle, the massive stratovolcano is the centerpiece of Mount Rainier National Park, which was established on March 2, 1899, as the fifth national park in the country.

The mountain is a highly active volcano that began building its present cone approximately 500,000 years ago. Geologically, it is the most topographically prominent mountain in the contiguous United States, rising abruptly from its surrounding landscape. Its complex history includes multiple eruptions, lava flows, and destructive lahars (volcanic mudflows). The most significant lahar was the Osceola Mudflow approximately 5,600 years ago, which sent a torrent of mud and debris all the way to Puget Sound and may have carried away much of the mountain's original summit. Today, the U.S. Geological Survey (USGS) extensively monitors the volcano to provide advance warning of future hazards.

Mount Rainier is the most heavily glaciated peak in the contiguous United States, covered by an extensive system of 25 named glaciers and large permanent snowfields that total about 35 square miles (91 km$&amp;$sup2;). These glaciers, which include the largest by area (Emmons Glacier) and largest by volume (Carbon Glacier), are vital water sources, feeding the headwaters of five major rivers, including the Nisqually, Puyallup, and Cowlitz rivers. Scientists rely on the mountain's glaciers as sensitive indicators of climatic change, noting that the mountain has lost approximately 40$%$ of its glacier area since the 1900s.

The entire area encompasses a dramatic ecological gradient. Below the permanent ice line, the mountain features high-elevation forests dominated by subalpine fir and mountain hemlock, which transition into spectacular subalpine meadows that erupt in a famous display of wildflowers during the short summer season (typically mid-July to mid-August). The mountain is a world-class destination for mountaineering, with the Disappointment Cleaver route being the most common, non-technical ascent route to the summit.</desc><sym>volcano</sym></wpt><wpt lat="46.4073397" lon="-121.8658948"><time>2022-07-13T23:46:12Z</time><name>DP - Burley Mountain Fire Lookout</name><desc>Burley Mountain Fire Lookout is a historic fire lookout station located on Burley Mountain in the Cowlitz Valley Ranger District of the Gifford Pinchot National Forest, Washington. Situated at an elevation of 5,154 feet (1,571 meters), the lookout stands at a central position in the southern Cascades, offering spectacular 360-degree views that encompass four major volcanoes: Mount Rainier to the north, Mount Adams to the east, Mount St. Helens to the southwest, and Mount Hood to the south.

The structure is a classic, 14-by-14-foot L-4 ground house built in 1934 by the U.S. Forest Service as part of the massive fire detection network established following the devastating &quot;Big Blowup&quot; fires of 1910. Burley Mountain was historically a crucial sentinel, and although the Forest Service phased out most manned lookouts by the 1960s, Burley was one of only three lookouts remaining on the Gifford Pinchot by 1973. The site was added to the National Historic Lookout Register in 2000.

The mountain's surrounding forest is a testament to the region's fire history, being largely composed of even-aged second-growth that sprung up after the massive fires in the Cispus Valley in the early 1900s. The trail to the lookout itself climbs through a landscape noted for its abundant huckleberries and wildflowers in late summer. The lookout is still occasionally staffed for fire detection during the summer season and, at times, has been made available for overnight rentals.</desc><sym>fire-lookout</sym></wpt><wpt lat="46.5324678" lon="-121.9561945"><time>2022-07-13T23:46:12Z</time><name>DP - Cowlitz River</name><desc>The Cowlitz River is a historically and ecologically significant waterway in southwest Washington, a major tributary of the Columbia River. The river’s source is fed by the glaciers of Mount Rainier and it gathers wild runoff from the slopes of both Mount Adams and Mount St. Helens. The Cowlitz is approximately 105 miles (169 km) long and drains an expansive 2,586-square-mile (6,698 km$&amp;$sup2;) basin that extends across the Cascade Range.

Historically, the river valley was the home of the Upper Cowlitz (Taidnapam) Indians, with a large village situated near the present-day town of Packwood. The Cowlitz Trail, an ancient Native American travel route, followed the river and connected the Cowlitz Valley with the Yakima River drainage across the Cascades.

Today, the lower Cowlitz River is heavily impacted by hydroelectric power generation. Two major dams—Mayfield Dam and Mossyrock Dam (forming Riffe Lake)—impound the river, creating large reservoirs that have altered the natural flow regime and blocked historical fish migration. However, the river remains one of Washington’s most important systems for recovering imperiled native fish, supporting runs of Chinook salmon, coho salmon, and summer and winter steelhead, which compete with large hatchery runs.

A significant portion of its headwaters and main tributaries, particularly the Cispus River and the Clear Fork Cowlitz River, flow through the Cowlitz Valley Ranger District of the Gifford Pinchot National Forest. This area, which includes the Goat Rocks Wilderness, offers diverse recreational opportunities, including hiking, camping, and wildlife viewing, featuring old-growth forests and important habitat for elk. The Cowlitz is best known among sport fishermen for the stretch below the Barrier Dam, where it is often one of the state's most productive fishing rivers year-round.</desc><sym>water</sym></wpt><wpt lat="46.4601156" lon="-121.8604313"><time>2022-07-13T23:46:12Z</time><name>Layser Cave</name><desc>ayser Cave (or the Layser Cave Archaeological Interpretive Area) is a small but highly significant natural rock shelter located in the Cowlitz Valley Ranger District of the Gifford Pinchot National Forest, situated above the Cispus River valley south of Randle, Washington. The site is recognized as one of the most extensive and important archaeological sites in the western Cascade Range, providing a continuous record of human use dating back at least 7,000 years (5000 BCE).

The cave’s geological formation is a subject of debate among experts. While it was initially suspected to be a lava tube due to the region's volcanic nature, geological evidence suggests it is a pseudokarst—a feature formed by the structural folding and fissuring of the underlying basalt rock during the Miocene uplift of the Cascade Range, not by flowing lava. The rock shelter is small, measuring approximately 20 feet wide and 32 feet deep, with a low ceiling, and its floor contains distinct layers of volcanic ash (tephra), including layers from ancient Mount St. Helens eruptions.

For thousands of years, the cave served as a long-term communal shelter and seasonal work site for the Indigenous peoples of the region, notably the Upper Cowlitz (Taitnapam) Indians. Archaeological excavations, which began after the cave's rediscovery by Forest Service employee Tim Layser in 1982, uncovered thousands of artifacts, including stone tools, animal bones (primarily deer and elk), and even obsidian arrowheads sourced from Oregon, providing evidence of trade and early Holocene migration patterns.

The archaeological record shows a notable period of abandonment between approximately 2,000 and 4,000 years ago, which is hypothesized to have occurred suddenly around 3,400 to 3,500 years ago, coinciding with a massive eruption of Mount St. Helens that buried settlements under a thick layer of pumice. Today, the site is managed by the U.S. Forest Service, which has installed interpretive signs along a short (0.25 mile), steep trail to explain the cave’s history and significance, offering visitors a unique perspective on the long human history of the Gifford Pinchot National Forest.</desc><sym>cave</sym></wpt><wpt lat="46.4514302" lon="-121.8312832"><time>2022-07-13T23:46:12Z</time><name>Camp Creek Falls</name><sym>waterfall</sym></wpt><wpt lat="45.7087047" lon="-121.7734799"><time>2022-07-13T23:46:12Z</time><name>Home Valley Campground</name><sym>campsite-24</sym></wpt><wpt lat="46.3596703" lon="-121.8880052"><time>2022-07-13T23:46:12Z</time><name>Campsite</name><sym>campsite-24</sym></wpt><wpt lat="46.3266906" lon="-121.9236918"><time>2022-07-13T23:46:12Z</time><name>DP - Pinto Rock</name><desc>Pinto Rock is a prominent geological feature and popular rock climbing crag located in the Cowlitz Valley Ranger District of the Gifford Pinchot National Forest, situated east of the Mount St. Helens National Volcanic Monument. The peak reaches an elevation of 5,123 feet (1,561 meters).

Geologically, Pinto Rock is a striking formation of welded-tuff breccia, a type of volcanic rock characterized by a rough surface heavily studded with knobs and blocks. This feature is responsible for the peak's renown as a climbing area. The cliff walls, which are up to 400 feet high, offer a unique combination of sport and traditional climbing routes. The climbing is often described as high-exposure friction climbing, with the most popular multi-pitch route being the Bowling Alley (Regular Route), rated at 5.4.

Pinto Rock is accessible via a network of rough, high-clearance Forest Service roads, including NF-25 and NF-77, and sits near the Boundary Trail (#1). Its isolated position contributes to an alpine feel, despite its modest elevation. From the summit, visitors are rewarded with a superb 360-degree panoramic view that includes the major Cascade volcanoes: Mount Adams, Mount Hood, Mount St. Helens, and Mount Rainier, making it a highly desirable viewpoint in the southern Cascades.

The area is also associated with Pinto Rock Falls, a small, unofficially named waterfall located on an unnamed stream to the south of the rock formation. The falls, a 44-foot vertical curtain over a basalt ledge, are a secondary feature of the remote, rugged landscape near the Cispus River watershed.</desc><sym>cliff</sym></wpt><wpt lat="46.1919593" lon="-122.1912594"><time>2022-07-13T23:46:12Z</time><name>DP - Mt St Helens</name><desc>Mount St. Helens (known as Lawetlat'la by the Cowlitz and Loowit or Louwala-Clough, the 'Smoking Mountain,' by the Klickitat) is a highly active stratovolcano in the Cascade Range of Washington. Before its catastrophic 1980 eruption, the mountain stood at 9,677 feet (2,950 meters) and was admired for its symmetrical, snow-capped cone, earning it the nickname &quot;Mount Fuji of America.&quot; The mountain is the central feature of the Mount St. Helens National Volcanic Monument, established in 1982 to preserve the area for scientific study, recreation, and education.

The volcano’s modern cone formed within the last 4,000 years, making it the youngest major volcano in the Cascades. Its most defining moment occurred on the morning of May 18, 1980. After weeks of precursory earthquakes and the rapid outward growth of a large bulge on its north flank, a magnitude 5.1 earthquake triggered the largest subaerial landslide in recorded history. This collapse suddenly relieved the pressure inside the volcano, resulting in a massive, high-velocity lateral blast of gas, steam, and rock debris that was directed north, devastating an area of nearly 600 square kilometers.

The eruption reduced the mountain's summit elevation by over 1,300 feet to its current height of 8,363 feet (2,549 meters), replacing the symmetrical cone with a massive, horseshoe-shaped crater that opens to the north. The blast and subsequent pyroclastic flows and lahars (volcanic mudflows) killed 57 people, destroyed vast tracts of forest (over 4 billion board feet of timber), and caused over $1 billion in damage. Lahars traveled down the Toutle and Cowlitz Rivers, sending sediment all the way to the Columbia River.

Following the 1980 eruption, a new lava dome began to slowly grow within the crater, a process that continues intermittently. The area is now a unique ecological laboratory where scientists study how life recovers from immense natural devastation. While the volcano’s dramatic topography and geology have stabilized since the end of its last eruptive episode in 2008, the entire area remains under constant monitoring by the U.S. Geological Survey (USGS) due to its high potential for future activity.</desc><sym>volcano</sym></wpt><wpt lat="45.7083642" lon="-121.8266111"><time>2022-07-13T23:46:12Z</time><name>DP - Columbia River Gorge</name><desc>The Columbia River Gorge is a spectacular river canyon, approximately 80 to 85 miles long and up to 4,000 feet deep, that carves the only sea-level passage through the Cascade Mountain Range. It serves as the border between the states of Washington (to the north) and Oregon (to the south). The area around Hood River sits in the transition zone of the Gorge, marked by a dramatic shift in ecology from the temperate rainforests of the west to the dry grasslands of the east, thanks to the Cascade Mountains' rain shadow effect.

The Gorge’s formation began tens of millions of years ago, but its present, dramatic form was created by two major geological events. The first was the colossal Columbia River Basalt Group flows between 17 and 6 million years ago, which extruded hundreds of flows from eastern vents, laying down layers of basalt up to 2,000 feet thick. The Columbia River maintained its course, continually eroding the land as the Cascade Range slowly uplifted. The second, and most defining, event occurred at the end of the last Ice Age, when the cataclysmic Missoula Floods repeatedly crashed through the canyon, scouring away loose sediment, exposing the layers of basalt, and carving the steep cliffs and numerous hanging waterfalls visible today.

For over 13,000 years, the Columbia River has been a crucial travel corridor and center of trade for Indigenous peoples, including the Chinookan and Sahaptin-speaking tribes. They referred to it as Nch'i-W'ana (The Great River). The river was, and remains, a source of sustenance, particularly for the enormous salmon runs. Following European contact in the late 18th century and the arrival of the Lewis and Clark Expedition in 1805, the Gorge became an essential route for fur traders and, later, for pioneers on the Oregon Trail, who often used the river or the strenuous Barlow Road bypass around Mount Hood.

Today, the Columbia River Gorge is protected as the Columbia River Gorge National Scenic Area, established by Congress in 1986. This designation protects its scenic, natural, cultural, and recreational resources across 292,000 acres managed by the U.S. Forest Service and the bi-state Columbia River Gorge Commission. The river remains an active commercial corridor, featuring two major railroads and barge navigation, and is a world-class destination for hiking, windsurfing, and sightseeing, especially near the town of Hood River.</desc><sym>water</sym></wpt><wpt lat="46.6042132" lon="-121.6727858"><time>2022-07-13T23:46:12Z</time><name>Gas Station</name><sym>fuel-24</sym></wpt><wpt lat="46.288818" lon="-121.96659"><time>2022-07-13T23:46:12Z</time><name>Elk Pass</name><sym>attraction</sym></wpt><wpt lat="45.7950053" lon="-121.6344417"><time>2022-07-13T23:46:12Z</time><name>Moss Creek Campground</name><sym>campsite-24</sym></wpt><wpt lat="45.758434" lon="-121.8372234"><time>2022-07-13T23:46:12Z</time><name>DP - High Bridge</name><desc>The High Bridge along the Wind River, officially known as the Conrad Lundy Wind River Bridge, is a significant vehicular crossing located in Skamania County, Washington, near the southern boundary of the Gifford Pinchot National Forest. The bridge carries Wind River Road (often designated as Forest Road 30) high above the deep, steep-sided canyon carved by the Wind River. The structure is an essential gateway, providing access to the upper Wind River Valley, the Wind River Experimental Forest, and the wilderness areas to the north.

The bridge deck sits approximately 260 feet above the river, a height that required specialized construction and maintenance techniques. The impressive drop provides a dramatic overlook of the river's course as it rushes through the gorge. The structure is a modern replacement for older crossings and was engineered to withstand the challenging terrain and conditions of the Cascade foothills.

The Wind River itself is a major tributary that flows south from the Cascade Mountains and empties into the Columbia River near the town of Carson, Washington. It is recognized as a scenic river and is highly valued for its recreational opportunities, including white-water rafting and kayaking. Ecologically, the river is critical, providing vital habitat and spawning grounds for various anadromous fish species, such as salmon and steelhead, which migrate from the Columbia River system.</desc><sym>bridge</sym></wpt><wpt lat="45.7593874" lon="-121.835913"><time>2022-07-13T23:46:12Z</time><name>DP - Wind River</name><desc>The Wind River is a major tributary of the Columbia River, originating in the Cascade Range of Washington, south of Mount Adams and Mount St. Helens, before flowing generally south through the Gifford Pinchot National Forest. Its entire course of approximately 30 miles (48 km) lies within Skamania County, and it joins the Columbia River near the town of Carson in the Columbia River Gorge.

Historically, the river was noted by the Lewis and Clark Expedition in 1805, who referred to it as the &quot;New Timbered River.&quot; Its watershed encompasses roughly 224 square miles (580 km$&amp;$sup2;). The river's rapid descent through a deep, basalt cliff-lined gorge has created an outstanding scenic corridor. Ecologically, the Wind River is a vital Tier I Key Watershed under the Northwest Forest Plan and is designated as a Wild Steelhead Gene Bank by the Washington Department of Fish and Wildlife.

The river is most famous for its wild summer steelhead run, which historically numbered in the thousands. The naturally difficult migratory conditions created by Shipherd Falls, near the river mouth, meant that only the more athletic summer steelhead and lamprey could historically pass. While fish populations declined due to historical logging practices, the construction of a splash dam that blocked migration until 1947, and external harvest pressures, extensive conservation efforts have been ongoing since the late 20th century to restore habitat and maintain the wild genetic stock.

Recreationally, the Wind River is a destination for experienced boaters. Its short, intense season, driven by rainfall and snowmelt, offers Class IV+ and Class V whitewater, particularly in the Upper Wind River section, which is known for its technical rapids like the &quot;Ram's Horn Sequence.&quot; Furthermore, the Wind River valley is home to the Wind River Experimental Forest, established in 1909, and the Wind River Arboretum, the oldest arboretum in the Pacific Northwest, providing unique opportunities for hiking and nature observation within the Gifford Pinchot National Forest.</desc><sym>water</sym></wpt><wpt lat="45.7855023" lon="-121.7365882"><time>2022-07-13T23:46:12Z</time><name>Triangle Pass</name><sym>attraction</sym></wpt><wpt lat="46.0581617" lon="-121.9723141"><time>2022-07-13T23:46:12Z</time><name>DP - Curly Creek Falls</name><desc>Curly Creek Falls is one of the most geologically unique waterfalls in the Pacific Northwest, located on Curly Creek just upstream from its confluence with the Lewis River, within the Gifford Pinchot National Forest in Washington. The falls are most famous for being one of the very few waterfalls in the world—perhaps only a handful—that has two natural basalt rock arches spanning its face, a feature resulting from the erosion of volcanic rock. In conditions of very low flow, a third arch may sometimes become visible.

The falls are a dramatic tiered plunge, estimated to drop approximately 78 to 86 feet in total. The unique geology suggests that the creek may have cut through an ancient lava tube or a highly fractured basalt structure. The flow is highly seasonal; the water level is greatest during spring melt (May and June), when the lower arch can be inundated and disappear beneath the water. In contrast, the creek is prone to running completely dry in late summer and early fall, as its flow is often diverted into sinkholes or lava tubes upstream.

The falls are an easily accessible destination via a short, gentle trail (part of the Lewis River Trail system) from the Curly Creek Falls Trailhead. The trail leads to a viewpoint across the Lewis River where visitors can look across the canyon at the unique rock arches. Located in the Lewis River Recreation Area, the falls are situated in a deep canyon surrounded by a magnificent old-growth forest of Douglas fir, western red cedar, and big leaf maple.</desc><sym>waterfall</sym></wpt><wpt lat="45.8532238" lon="-121.7203839"><time>2022-07-13T23:46:12Z</time><name>DP - Big Lava Bed</name><desc>he Big Lava Bed is a vast, rugged, and geologically young lava flow located in the southern part of the Indian Heaven Volcanic Field within the Gifford Pinchot National Forest in Skamania County, Washington. The field itself is situated between Mount St. Helens and Mount Adams. The Big Lava Bed is recognized as the most recent eruption in the Indian Heaven field, occurring approximately 8,200 years ago (6250 BCE $&amp;$plusmn; 100 years).

The flow originated from a single vent—a cinder cone that rises to an elevation of 4,195 feet. This basaltic lava flowed southward, traveling an impressive 13 to 25 kilometers (8 to 15 miles) from its source, covering an area of around 20 square miles (52 km$&amp;$sup2;) and having a volume of approximately 0.9 cubic kilometers. The flow is primarily composed of ʻaʻā and block lava, which resulted in an extremely broken, sharp, and jumbled landscape, earning it its name.

The Big Lava Bed is a significant speleological area, containing a large, complex network of lava tubes and caves, such as the Big Huckleberry system. The broken surface of the flow, known as microtopography, is largely due to the process of flow inflation, where the crust hardened while molten lava continued to push beneath it. This highly porous geology dictates the hydrology of the area, notably at nearby South Prairie Lake, which forms seasonally as snowmelt collects, but quickly drains away as the weather warms and the ice &quot;plugs&quot; in the lava tubes melt.

The terrain is notoriously difficult to traverse; the dense jumble of broken basalt blocks lacks marked roads or trails across its interior. Vegetation consists mainly of sparse, stunted lodgepole pine and other pioneer plants that struggle to establish roots in the fractured rock. The remoteness and difficult access have preserved the Big Lava Bed as one of the least explored and most pristine areas in the South Cascades.</desc><sym>volcano</sym></wpt><wpt lat="46.0670247" lon="-121.9278136"><time>2022-07-13T23:46:12Z</time><name>Rush Creek Falls</name><sym>waterfall</sym></wpt><wpt lat="45.9447262" lon="-121.8680716"><time>2022-07-13T23:46:12Z</time><name>DP - Falls Creek Lava Caves</name><desc>Falls Creek Lava Caves (sometimes referred to collectively as the Falls Creek Cave System) is an extensive and highly significant geological feature located in the Wind River valley of the Gifford Pinchot National Forest, near Carson, Washington. This system is a large lava tube, formed during a basaltic flow from the nearby Big Lava Bed eruption approximately 8,200 years ago.

The main cave, Falls Creek Cave, is estimated to be over 1.2 miles (2,000 meters) long, making it one of the longer unmaintained lava tubes in Washington State. It is characterized by three distinct breakdown pits (collapsed sections of the tube) visible from the surface. The entrance is typically accessed through the second of these pits, requiring a challenging descent over piles of jagged boulders. The interior is generally unlit, pitch black, and features numerous side passages, slippery clay floors, and challenging scrambles over massive rockfalls, demanding caution and multiple reliable light sources.

Geologically, the cave preserves unique features of its volcanic origin, including solidified lava drippings (known as lavacicles) and evidence of flow dynamics. The cave is part of a complex system where the surface creek, Falls Creek, seasonally sinks into the lava tube system through sinkholes and fissures before emerging further downstream. Due to its unmaintained status, the cave offers a rugged and challenging spelunking experience, contrasting with the more accessible and developed Ape Cave near Mount St. Helens.

The cave is located near the trailhead for the scenic Falls Creek Falls, and is often included in a longer recreational loop. Access is via a spur road off Wind River Road (Forest Road 30), and due to the high-elevation location and winter road closures, exploration is typically restricted to the snow-free season. The remote location and challenging nature of the cave require all visitors to be self-sufficient and practice strict Leave No Trace principles.












Tools</desc><sym>cave</sym></wpt><wpt lat="45.9412627" lon="-121.7636038"><time>2022-07-13T23:46:12Z</time><name>DP - Goose Lake</name><desc>Goose Lake is a scenic, 58-acre lake located within the Mount Adams Ranger District of the Gifford Pinchot National Forest in Skamania County, Washington, at an elevation of approximately 3,110 feet (950 meters). The lake’s formation is a direct result of the volcanic history of the region. Approximately 8,200 years ago, a massive lava flow from the Big Lava Bed—a part of the Indian Heaven Volcanic Field—dammed a nearby stream, creating the basin that filled to become the lake.

The geological impact of this damming event is clearly visible today. The lake is characterized by a haunting landscape feature: a stand of dead, submerged trees that rise from its waters, marking the original forest that was drowned when the lava flow blocked the natural drainage. The highly porous basalt of the surrounding Big Lava Bed ensures that Goose Lake’s hydrology is dominated by surface inflow and seepage, with no significant surface outlet.

Goose Lake is a popular recreational destination, particularly during the late summer and early autumn when the weather is warm and the surrounding forest is prime for huckleberry picking. The lake is regularly stocked with fish, making it a favorite spot for anglers seeking brook, brown, and coastal cutthroat trout. Its calm waters and lack of motorized boat traffic make it ideal for non-motorized activities such as kayaking, canoeing, and swimming.

The lake is accessible via Forest Road 60 (Carson Guler Road), which connects the area to both the communities of Trout Lake and Carson. The nearby attractions include the aforementioned Big Lava Bed, which features trails through its rugged basalt landscape, and the vast Indian Heaven Wilderness to the north. Goose Lake Campground offers primitive, walk-in tent sites on the hillside above the lake, providing a remote, rustic camping experience within the Cascade mountains.</desc><sym>lake</sym></wpt><wpt lat="45.9249927" lon="-121.6629149"><time>2022-07-13T23:46:12Z</time><name>Monte Cristo Slab</name><desc>The Monte Cristo Slab (MCS) is a popular rock-climbing destination located on the western slope of the Monte Cristo Range in the southern portion of the Gifford Pinchot National Forest, near the community of Trout Lake, Washington. Although the name &quot;Monte Cristo&quot; is also associated with a historical mining town and a peak in the North Cascades, this particular slab is a distinct, high-altitude climbing area in the South Cascades.

Geologically, the slab is composed of diorite, an intrusive granitic stock that is darker in color than typical granite due to a lack of quartz. This rock forms a large, continuous face, or slab, that provides a unique friction-climbing experience. The climbing routes primarily range from easy to moderate difficulty, generally falling between 5.3 and 5.9, making the area exceptionally well-suited for beginner climbers, family cragging, and those looking to practice smearing and slab technique.

The Monte Cristo Slab is well-regarded for its extensive development as a sport climbing area, with the majority of its routes being bolted, allowing for straightforward lead climbing and protection. The height of the slab is considerable, with some routes extending approximately 250 feet, which are typically climbed in a single pitch. Climbers can descend via designated rappel anchors, including a central &quot;ravine rappel&quot; or a walk-off option.</desc><sym>cliff</sym></wpt><wpt lat="45.9356072" lon="-121.821375"><time>2022-07-13T23:46:12Z</time><name>Red Mountain Fire Lookout</name><desc>The Red Mountain Fire Lookout is a historic and popular destination in the southern portion of the Gifford Pinchot National Forest, situated near the boundary of the Indian Heaven Wilderness in Skamania County, Washington. At an elevation of 4,965 feet, the lookout offers one of the most comprehensive panoramic views in the South Cascades, encompassing Mount Rainier, Mount St. Helens, Mount Adams, and Mount Hood.

The site on Red Mountain holds a distinguished place in the history of forest fire prevention for the region. The first lookout structure was established on the summit in 1910, making it the first lookout point identified in what was then the Columbia National Forest (now the Gifford Pinchot). The current structure is the fourth on the site, built in 1959, featuring a 10-foot timber tower with a standard Forest Service R-6 flattop cab. The site was historically critical; during World War II (1942-1943), it was staffed 24 hours a day as an Aircraft Warning Station to monitor for enemy aircraft. The original Civilian Conservation Corps (CCC) garage, converted to living quarters for the wartime spotters, still stands on the site.

Although the lookout is no longer staffed by the Forest Service for fire detection (which is now primarily done via satellites), the structure has been preserved and is maintained by volunteer efforts, notably after a severe windstorm in 2006 caused significant damage. It is a key recreational destination, with hikers typically accessing the site via the Indian Racetrack Trail (#171), or by hiking a gated access road (Forest Road 6048). The trail passes through a unique landscape, including the Indian Racetrack meadow, an area rich in huckleberries, before climbing to the summit.</desc><sym>fire-lookout</sym></wpt><wpt lat="45.8671944" lon="-121.8288441"><time>2022-07-13T23:46:12Z</time><name>DP - Panther Creek Falls</name><desc>Panther Creek Falls is one of the most impressive and complex waterfalls in the Wind River Valley, located within the Gifford Pinchot National Forest, north of Carson, Washington. It is a highly popular and easily accessible destination in the Mt. Adams Ranger District. The total drop of the falls is estimated to be approximately 130 to 136 feet over a series of steps and plunges, distinguishing it from many single-drop waterfalls in the region.

The falls are characterized by a unique, multi-channel flow where Panther Creek and a large spring converge over a steep, mossy cliff face. Most of the creek's flow is channeled into a deep groove that steers the water over a two-tier plunge, while a separate, significant portion of water emerges from the canyon wall as a broad veil of springs, cascading down a sheer, moss-laden rock face before merging with the creek’s main flow in the plunge pool below. This complexity of water sources and varied drops makes for a mesmerizing, high-volume spectacle, particularly during high water.

The area is maintained by the U.S. Forest Service (Trail $#$137) and offers a very short, downhill hike (less than 0.7 miles round-trip) to two distinct viewpoints. The upper viewpoint provides a dramatic view of the convergence of the water over the upper tier, while the lower viewpoint (which is a more technical descent) offers a magnificent, close-up perspective of the main plunge and the mossy rock walls.</desc><sym>waterfall</sym></wpt><wpt lat="45.9581497" lon="-121.7558541"><time>2022-07-13T23:46:12Z</time><name>DP - Forlorn Lakes</name><desc>The Forlorn Lakes are a chain of small, picturesque mountain lakes situated in the Mount Adams Ranger District of the Gifford Pinchot National Forest, Washington, at an approximate elevation of 3,700 feet. The cluster includes around 12 separate bodies of water, which are a major focal point for recreation in the southern part of the forest, located near the boundary of the Indian Heaven Wilderness.

The location is renowned for its huckleberry fields. The surrounding forest, primarily consisting of fir, spruce, and hemlock, transitions into meadows dense with low-growing shrubs, making the area extremely popular during the late summer and early autumn harvest season. Due to the beauty and popularity, the Forlorn Lakes Campground is a primary destination, offering 25 first-come, first-served campsites scattered around the shores of the largest lakes.

Recreational activities focus on the water and the surrounding trails. Fishing is popular in the larger lakes, which are typically stocked with trout. Non-motorized water activities like kayaking, canoeing, and swimming are common during the warmer months. Furthermore, the lakes provide nearby access to the Indian Heaven Wilderness via the East Crater Trailhead, allowing hikers and backpackers to enter a high plateau noted for its abundant alpine lakes and volcanic features.</desc><sym>lake</sym></wpt><wpt lat="45.9686020584555" lon="-121.65794134140015"><time>2025-10-08T13:55:01Z</time><name>Peterson Prairie Campground</name><desc>Peterson Prairie Campground is a campsite inside of Gifford Pinchot National Forest.

Activities: , 
Amenities: campsite
Camping: RVs

Websites:
https://www.recreation.gov/camping/campgrounds/232895</desc><sym>campsite-24</sym></wpt><wpt lat="45.97018294192685" lon="-121.65952920913696"><time>2025-10-08T13:55:10Z</time><name>Interpretive Site: Peterson Prairie</name><sym>information</sym></wpt><wpt lat="46.069404787927425" lon="-121.75580978393555"><time>2025-10-08T13:57:20Z</time><name>Meadow Creek Indian Campground</name><desc>Meadow Creek Indian Campground is a campsite inside of Gifford Pinchot National Forest.

Amenities: campsite</desc><sym>campsite-24</sym></wpt><wpt lat="46.0538329" lon="-121.7504926"><time>2022-07-13T23:46:12Z</time><name>Indian Viewpoint</name><sym>binoculars</sym></wpt><wpt lat="46.095372594088246" lon="-121.71658246202995"><time>2022-07-13T23:46:12Z</time><name>DP - Basket Tree Interpretive Site</name><desc>The Basket Tree Interpretive Site is a culturally significant location within the Gifford Pinchot National Forest, situated near the Wind River and the community of Trout Lake, Washington. This site preserves an important record of the traditional resource use by the Indigenous peoples of the region, notably the Cowlitz Indian Tribe and Klickitat, for whom the forest was a vital resource.

The site’s primary focus is a stand of Western Red Cedar ( Thuja plicata ) trees that bear distinct, vertical scars. These scars are a result of a sustainable harvesting practice where Native Americans carefully removed the outer and inner bark from the living tree, a process known as peeling. The highly valued, flexible inner bark was then used to weave essential items such as baskets, clothing, mats, and rope. The scars on these trees indicate that they have been harvested in this manner over centuries.

By selectively removing a strip of bark without girdling (circling) the tree, the Indigenous people ensured the tree would continue to live and grow, sometimes for hundreds of years afterward, allowing the same tree to be harvested multiple times across generations. This practice demonstrates a deep, conservation-minded relationship with the forest and provides invaluable archaeological and historical evidence of traditional lifeways and material culture in the Cascade Mountains.

The site features an accessible loop trail with interpretive signs that explain the practice of cedar bark removal, the cultural significance of the cedar tree, and the resulting historical and archaeological context of the peeled cedars. The interpretive trail provides a quiet, educational experience set within an old-growth forest environment, often near Langfield Falls, making it a point of historical and natural interest within the Mount Adams Ranger District.</desc><sym>attraction</sym></wpt><wpt lat="46.0985052" lon="-121.7186593"><time>2022-07-13T23:46:12Z</time><name>DP - Langfield Falls</name><desc>Langfield Falls is a scenic waterfall located in the Gifford Pinchot National Forest in Skamania County, Washington, nestled in the area west of Mount Adams. It is a popular, easily accessible destination known for its short, family-friendly trail. The falls are situated on Big Mosquito Creek, a tributary within the larger White Salmon River watershed, and the water descends over a prominent ledge of volcanic rock known as conglomerated breccia.

The waterfall has an official height of approximately 57 to 59 feet (17 to 18 meters), cascading in a single drop that typically takes a horsetail form. While the volume and width of the falls vary greatly with the season, in high-flow conditions—such as during spring melt—the water spreads wide, dramatically altering the character of the site. In late summer, the flow can be more concentrated, often limited to one side of the cliff face.

The falls and the surrounding area are named in honor of Karl C. Langfield (K.C. Langfield), a longtime Forest Service Ranger in the Mt. Adams Ranger District who served from 1933 to 1956. The short trail (around 0.3 miles round-trip) leading to the base of the falls was built as a memorial to him, and a commemorative plaque is often found near the main viewpoint. The location is easily accessed via Forest Road 88, near the Big Tire Junction.

The lush forest along the trail is dominated by tall Douglas firs, vine maples, and a ground cover of mountain huckleberry bushes. The trail descends through a series of switchbacks to the base of the falls, where the small pool and scattered boulders allow for viewing and, in summer, opportunities to cool off near the water. The surrounding area once hosted an old mill, the stone remnants of which can still be discerned near the creek bed.</desc><sym>waterfall</sym></wpt><wpt lat="46.09061474770098" lon="-121.75909280776978"><time>2025-10-08T13:59:19Z</time><name>Camp site</name><sym>campsite-24</sym></wpt><wpt lat="46.0881532" lon="-121.7678311"><time>2022-07-13T23:46:12Z</time><name>DP - Berry Fields Interpretive Site</name><desc>The Berry Fields Interpretive Site is a highly significant cultural and ecological location within the Gifford Pinchot National Forest, situated near the northern border of the Indian Heaven Wilderness, often referred to as the Sawtooth Berry Fields. For over 9,000 years, this area has been a traditional gathering place for numerous Northwest Indigenous tribes, including the Yakama, Klickitat, Wasco, and Umatilla, who referred to the broader area as Sahalee Tyee (often translated as &quot;The Great God’s Country&quot; or &quot;The High Place&quot;).

The primary focus of the site is the abundant thinleaf huckleberry (Vaccinium membranaceum), or wíwnu, which is a vital traditional food source. The interpretive signs focus on the history and culture of the annual harvest, which served not only as an essential food-gathering activity (the berries were dried for winter use) but also as a crucial social and spiritual event. The gatherings included ceremonies, trading, horse racing on the nearby Indian Racetrack meadow, and the playing of traditional games like palyúut (the bone game).

The rich productivity of the fields is partially a result of traditional land management practices. Historically, Native Americans would conduct low-intensity, controlled burns to clear out competing conifers and encourage huckleberry growth. This practice maintained the open fields necessary for maximizing the harvest. Following the Great Fires of 1902 and subsequent U.S. Forest Service fire suppression policies, these fields began to shrink, leading to collaborative efforts between the Forest Service and tribal nations for conservation.

The location holds continued cultural importance today. A Handshake Agreement established in 1932 between the Forest Service and the Yakama Nation officially designated a portion of the Sawtooth Berry Fields (east of Forest Road 24) for the exclusive use of local Indian peoples for their traditional food gathering, a commitment that remains part of the Forest’s current Land and Resource Management Plan. The site serves as a vital reminder of the deep, enduring cultural connection between the land and its first inhabitants.</desc><sym>attraction</sym></wpt><wpt lat="46.09498732585038" lon="-121.76572838859153"><time>2025-10-08T14:00:36Z</time><name>Camp</name><sym>campsite-24</sym></wpt><wpt lat="46.092307938185485" lon="-121.76558966193689"><time>2025-10-08T14:00:06Z</time><name>Trail camp</name><sym>campsite-24</sym></wpt><wpt lat="46.09453141230148" lon="-121.76526691615902"><time>2025-10-08T14:00:29Z</time><name>Camp</name><sym>campsite-24</sym></wpt><wpt lat="46.1379788" lon="-121.7277398"><time>2022-07-13T23:46:12Z</time><name>DP - Steamboat Mountain Lookout</name><desc>Steamboat Mountain is a prominent peak located in the Gifford Pinchot National Forest, situated northwest of Mount Adams in Skamania County, Washington, with an elevation of 5,424 feet. The peak is a distinctive feature of the local landscape and serves as a major viewpoint for the surrounding Cascade Mountains.

The mountain's summit was historically the location of the Steamboat Mountain Fire Lookout. Developed with a 14x14-foot cabin in 1928, the site was later upgraded. A 20-foot tall treated timber tower with an R-6 flattop cab was constructed in 1956. The lookout was actively staffed for several years but was subsequently decommissioned and removed around 1966, reflecting the Forest Service's shift from manned lookouts to aerial and satellite fire detection. Today, only the footings of the old fire tower remain, along with a 1937 USDA Forest Service brass survey marker.

Steamboat Mountain is a popular hiking destination, particularly in the late summer, when the trail passes through dense, mature huckleberry bushes. The approximately half-mile trail to the summit (Trail #14, Steamboat Viewpoint) is often accessed via a network of Forest Service roads, including Forest Road 8851 and 8854, near the Big Tire intersection. The area is part of a non-motorized recreation zone and is known for its spectacular 360-degree views.

From the exposed summit, hikers can attain panoramic views of the major Cascade volcanoes, including the imposing Mount Adams immediately to the east, as well as Mount Rainier, Mount St. Helens, and Mount Hood. Below the peak to the southeast is Steamboat Lake, and to the southwest is Big Mosquito Lake, adding to the scenic value of the viewpoint.












Tools</desc><sym>binoculars</sym></wpt><wpt lat="46.1536338" lon="-121.6284801"><time>2022-07-13T23:46:12Z</time><name>Mt Adams Viewpoint</name><sym>binoculars</sym></wpt><wpt lat="46.1638419" lon="-121.6384314"><time>2022-07-13T23:46:12Z</time><name>Swampy Meadows</name><desc>Swampy Meadows is a high-elevation meadow and subalpine ecosystem located on the western slope of Mount Adams, within the Gifford Pinchot National Forest in Washington State. It is situated in the Mount Adams Ranger District, near the Midway High Lakes Area, at an approximate elevation of 3,750 feet (1,143 meters). The meadows are characterized by a mosaic of forested areas and marshy, open ground created by poor natural drainage, which contributes to the name &quot;Swampy.&quot;

The meadow area serves as the headwaters and drainage basin for several small creeks and runoff channels, most notably giving rise to the unnamed tributary that forms the scenic Swampy Creek Falls before it joins the White Salmon River system. The ground is typically saturated through the spring and early summer due to heavy snowmelt, supporting a rich biodiversity of moisture-loving plants. The meadow is seasonally popular for its abundance of wildflowers and for attracting wildlife, including elk and various bird species.</desc><sym>marsh</sym></wpt><wpt lat="46.2782671" lon="-121.5963891"><time>2022-07-13T23:46:12Z</time><name>DP - Takhlakh Lake</name><desc>Takhlakh Lake is a stunning, natural, high-elevation lake situated at 4,390 feet in the Cowlitz Valley Ranger District of the Gifford Pinchot National Forest, approximately 7.3 miles northwest of Mount Adams in Washington State. The lake is the centerpiece of the popular Midway High Lakes Area and is renowned for offering one of the most picturesque and classic views of Mount Adams, whose snowy cone is perfectly reflected in the lake's still, non-motorized waters on clear mornings.

The lake itself is a direct product of the volcanic history of Mount Adams. It was formed when the Takh Takh Lava Flow—a significant eruption that occurred on the mountain’s flank approximately 3,500 to 1,000 years ago—flowed downhill and naturally dammed the drainage basin of a small tributary feeding into the Cispus River system. The resulting basin filled with water to create the 33-acre lake. The name Takhlakh originates from a Native American word, takh, meaning &quot;meadows,&quot; referring to the adjacent, often swampy Takh Takh Meadows that bloom with wildflowers.

Takhlakh Lake is a highly sought-after recreational destination, offering a popular campground with 54 sites that are generally open from early July through September. The lake is reserved exclusively for non-motorized uses, attracting anglers, kayakers, and canoeists. An accessible, 1.1-mile loop trail, the Takhlakh Loop Trail (#134), encircles the lake, providing multiple viewpoints of the mountain and access to the Takh Takh Meadows Trail (#136), which climbs onto the ancient lava flow itself.</desc><sym>lake</sym></wpt><wpt lat="46.2030763" lon="-121.4914944"><time>2022-07-13T23:46:12Z</time><name>DP - Mt Adams</name><desc>Mount Adams (known as Pahto or Pah-to by the Yakama Nation and Klickitat people) is the second-highest peak in Washington State, towering to an elevation of 12,276 feet (3,742 meters). It is a massive, active stratovolcano situated in the Cascade Range, approximately 30 miles north of the Columbia River, and is considered the second most voluminous volcano in the Cascades after Mount Shasta. The mountain’s broad, 18-mile-wide base and distinctive flat-topped summit profile are the result of multiple eruptive vents and long periods of glaciation, which eroded the structure over its 520,000-year history.

Geologically, Mount Adams is composed mainly of andesite and basaltic lavas, and it is the central and largest feature of the 500-square-mile Mount Adams Volcanic Field. Its most recent lava flow is estimated to be about 1,000 years old, although significant debris avalanches, such as the Trout Lake Mudflow (approximately 6,000 years ago), have occurred more recently, posing the greatest future hazard to downstream communities. The summit and its upper flanks are covered by a permanent icecap and 10 active glaciers, including the Klickitat, White Salmon, and Adams Glaciers, which are vital sources for the White Salmon and Lewis River systems.

For the Indigenous peoples of the region, Pahto is a sacred landmark and a source of essential resources, notably huckleberries from the surrounding subalpine meadows. Its eastern half lies within the Yakama Nation Indian Reservation and is closed to most public recreation, while the western half, including the summit, is managed as the Mount Adams Wilderness by the U.S. Forest Service, part of the Gifford Pinchot National Forest. The mountain was designated as a Wilderness Area in 1964.

Climbing Mount Adams is a popular objective for mountaineers. The most frequented route is the non-technical South Climb, which begins near Trout Lake and involves a strenuous 6,700-foot elevation gain, typically requiring snow travel, an ice axe, and crampons to reach the summit. An historic, partially preserved fire lookout cupola, dating from 1922, stands near the summit, making it the highest former lookout in Washington State, a relic of early 20th-century forest protection efforts.</desc><sym>volcano</sym></wpt><wpt lat="46.2716463" lon="-121.6379407"><time>2022-07-13T23:46:12Z</time><name>DP - Council Bluff</name><desc>Council Bluff is a prominent, semi-open summit located in the Cowlitz Valley Ranger District of the Gifford Pinchot National Forest, Washington, within the Midway High Lakes Area near Mount Adams. The bluff reaches an elevation of approximately 4,800 feet and offers a short but rewarding climb for hikers seeking panoramic mountain views.

The site is historically significant as the location of an early Forest Service fire observation post. A fire lookout structure was first built on top of Council Bluff in 1932. Although the lookout structure was removed in the 1960s as fire detection methods shifted, the area remains a highly valued viewpoint. Today, only the footings and other minor relics of the former lookout remain on the summit.

The bluff's primary draw is the sweeping, multi-peak vista it provides. From the top, visitors can clearly see the west slope of Mount Adams directly to the east. By scanning the horizon, they can also typically spot three other major Cascade volcanoes: Mount Rainier to the north, Mount Hood to the south, and Mount St. Helens to the west (though views of St. Helens can sometimes be partially obscured by trees). Below the bluff to the southeast lies Council Lake, a small, accessible lake that serves as the starting point for the hike.

Access to the summit is provided by the short Council Bluff Trail (#117), which branches off the Boundary Trail (#1). While the initial section of the trail from the Council Lake Campground follows an old, rocky road that is shared with off-road motorcyclists, the final section to the summit is generally reserved for hiker use, climbing through a subalpine forest before emerging onto the open, often windswept bluff.</desc><sym>cliff</sym></wpt><wpt lat="46.2646371" lon="-121.6315627"><time>2022-07-13T23:46:12Z</time><name>DP - Council Lake</name><desc>Council Lake is a high-elevation, naturally occurring lake located within the Gifford Pinchot National Forest in Skamania County, Washington, near the western base of Mount Adams. Situated at an elevation of approximately 4,200 feet, the lake is a popular destination within the Midway High Lakes Area, known for its scenic views and rustic recreation opportunities.

The lake is relatively small, but its peaceful, non-motorized waters make it ideal for canoeing, kayaking, and fishing. Council Lake is regularly stocked with fish, attracting anglers in search of rainbow and cutthroat trout. Its shores are lined with dense subalpine forest, creating a tranquil environment for campers, particularly during the short summer season (typically May through October, depending on snow conditions).

A primary function of the lake is to serve as the trailhead and base camp for the nearby Council Bluff summit. The Council Lake Campground, which features a limited number of primitive, free campsites, offers direct access to the Boundary Trail (#1) and the short Council Bluff Trail (#117). This proximity makes the lake a starting point for hikers who seek the panoramic views of Mount Adams, Mount Rainier, and Mount Hood from the old lookout site above.

Like many lakes in the Mount Adams area, the hydrology of Council Lake is deeply connected to the region's volcanic and glacial history, fed primarily by snowmelt and seasonal runoff. The area is also part of a wider ecosystem that supports a variety of wildlife, including elk and black bears, requiring visitors to be diligent about proper food storage while recreating.</desc><sym>lake</sym></wpt><wpt lat="46.2681516" lon="-121.6046563"><time>2022-07-13T23:46:12Z</time><name>DP - Babyshoe Pass</name><desc>Babyshoe Pass is a high mountain pass located in the Gifford Pinchot National Forest in Skamania County, Washington, nestled on the northwest flank of Mount Adams. The pass has an elevation of approximately 4,350 feet (1,326 meters) and is a critical point in the forest's transportation network, as it is traversed by Forest Route 23 (NF-23). This route provides a main north-south access corridor on the east side of the forest, connecting the communities of Trout Lake to the south and Randle to the north.

The pass is geographically significant because it marks a subtle hydrographic divide. It separates the headwaters and drainage areas of the Lewis River Watershed to the west from the Cispus River drainage to the north. The surrounding area is part of the Midway High Lakes Area, a popular recreation zone that includes several high-elevation lakes such as Takhlakh Lake, Forlorn Lakes, and Council Lake, all within a short radius.

Accessing the pass is a major part of the journey. While much of NF-23 is paved, the section that traverses Babyshoe Pass is characterized by a roughly 12-mile stretch of gravel road. This unpaved portion is typically only open during the snow-free months, generally from early summer through late fall, and is known to be rough and dusty, particularly in late summer.

The area is valued for its scenery and serves as a trailhead for various recreational activities. It provides access to multiple trails within or near the Mount Adams Wilderness and offers rewarding views of the surrounding Cascade Range, including the dramatic presence of Mount Adams. The surrounding area is also the source for the small stream that forms the similarly named Babyshoe Falls.</desc><sym>attraction</sym></wpt><wpt lat="46.2723377" lon="-121.5850195"><time>2022-07-13T23:46:12Z</time><name>DP - Takh Takh Lava Flow</name><desc>The Takh Takh Lava Flow is a geologically young and prominent basaltic lava field located on the northwest flank of Mount Adams, within the Gifford Pinchot National Forest in Washington State. This flow originated from a flank vent low on the main volcano's edifice, and it traveled approximately 10 kilometers (6 miles) northwest, flowing past the current location of Takhlakh Lake. The flow consists of blocky, rubbly gray boulders of andesite, creating a stark, jumbled, and difficult-to-traverse landscape that contrasts sharply with the surrounding dense forest.

The flow’s age is significant in the context of Mount Adams’s history, with the eruption believed to have occurred during the Holocene epoch, and it is known to be overlain by tephra (ash) layers dating to about 3,500 years ago. The lava flow is responsible for the formation of nearby Takhlakh Lake and the associated Takh Takh Meadows. The eruption effectively dammed the natural drainages of the area, allowing the basin to fill with water and form the lake, which is now famous for its clear reflection of Mount Adams.

The Takh Takh Lava Flow is a key recreational feature in the popular Midway High Lakes Area. The Takh Takh Meadows Trail (#136) is a specific, well-maintained route that climbs a portion of the flow. This section of the trail, which has been cut through the volcanic rock, provides hikers with stunning views to the north of Mount Rainier and the jagged peaks of the Goat Rocks Wilderness, while views of Mount Adams are often best observed from the edge of the adjacent Takh Takh Meadow. An interpretive sign is often located at the base of the flow, providing insights into its age and volcanic origin.</desc><sym>volcano</sym></wpt><wpt lat="46.25534875800656" lon="-121.60873747043782"><time>2025-10-08T14:05:40Z</time><name>DP - Lewis River</name><desc>The Lewis River is a major tributary of the Columbia River, originating from the Adams Glacier on the west flank of Mount Adams in southwest Washington State. It flows for approximately 95 miles (153 km), draining a vast basin of about 1,046 square miles, before joining the Columbia River near Woodland. Unlike nearby Lewis County, the river was named for an early pioneer, A. Lee Lewis, who settled near its mouth. Historically, the river and its abundant salmon runs were central to the life and culture of Indigenous peoples, including the Cowlitz, Yakama, Klickitat, and Chinook.

The river's course is now characterized by its extensive hydroelectric development. The river's North Fork is impounded by a series of four major dams—Swift Dam (forming Swift Reservoir), Yale Dam (forming Yale Lake), and Merwin Dam (forming Lake Merwin)—constructed between 1931 and 1958. These facilities provide power and create popular reservoirs for recreation like boating, camping, and fishing, but they have also blocked anadromous fish, such as salmon and steelhead, from accessing over 170 miles of historical spawning and rearing habitat in the upper basin.

A significant portion of the river flows through the Lewis River Recreation Area in the Gifford Pinchot National Forest, an area known for its lush, moss-cloaked old-growth forest. This section is famous for the Lewis River Falls, a sequence of large, spectacular waterfalls including the Lower Lewis River Falls (43 feet high and over 200 feet wide) and the Upper Lewis River Falls (58 feet high). The Lewis River Trail runs alongside the river, offering a 14-mile route that connects various recreation sites and provides access to the major falls.

Ongoing efforts, formalized through a 2004 settlement agreement and subsequent regulatory action by the Federal Energy Regulatory Commission (FERC), require the dam operators to implement upstream and downstream fish passage facilities at the dams. These projects, which have faced delays, are critical for restoring access to the high-quality upstream spawning grounds and are a key component of salmon and bull trout recovery for the entire Lower Columbia River ecosystem.</desc><sym>water</sym></wpt><trk><name>Washington Cascades Adventure Route</name><desc></desc><extensions><line xmlns="http://www.topografix.com/GPX/gpx_style/0/2"><color>F42410</color></line></extensions><trkseg><trkpt lat="45.715179" lon="-121.828143"><ele>88.91217136</ele><time>2022-05-25T19:15:42Z</time></trkpt><trkpt lat="45.714986" lon="-121.829042"><ele>89.36865856</ele><time>2022-05-25T19:15:42Z</time></trkpt><trkpt lat="45.715051" lon="-121.829354"><ele>94.00076032</ele><time>2022-05-25T19:15:42Z</time></trkpt><trkpt lat="45.715252" lon="-121.82921"><ele>94.0625536</ele><time>2022-05-25T19:15:42Z</time></trkpt><trkpt lat="45.715522" lon="-121.828394"><ele>96.30158272</ele><time>2022-05-25T19:15:42Z</time></trkpt><trkpt lat="45.716185" lon="-121.827258"><ele>103.3216</ele><time>2022-05-25T19:15:42Z</time></trkpt><trkpt lat="45.717121" lon="-121.826191"><ele>116.0848</ele><time>2022-05-25T19:15:42Z</time></trkpt><trkpt lat="45.717262" lon="-121.825927"><ele>119.14977408</ele><time>2022-05-25T19:15:42Z</time></trkpt><trkpt lat="45.71797" lon="-121.8239"><ele>122.82864</ele><time>2022-05-25T19:15:42Z</time></trkpt><trkpt lat="45.718357" lon="-121.82311"><ele>124.6642992</ele><time>2022-05-25T19:15:42Z</time></trkpt><trkpt lat="45.71957" lon="-121.821201"><ele>126.452</ele><time>2022-05-25T19:15:42Z</time></trkpt><trkpt lat="45.719798" lon="-121.820944"><ele>126.944</ele><time>2022-05-25T19:15:42Z</time></trkpt><trkpt lat="45.720165" lon="-121.820725"><ele>127.85966</ele><time>2022-05-25T19:15:42